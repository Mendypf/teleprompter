<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- The only permission: the mic. There is no internet permission, so nothing can leave the phone. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Lets the app see the phone's built-in speech service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_rules"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prompter"
        tools:targetApi="37">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Exported because Android itself binds to it; only the system holds this permission. -->
        <service
            android:name=".ProbeService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/probe_service" />
        </service>

        <!-- Start/stop from a computer over adb. Only adb and the system hold DUMP, so no app can press it. -->
        <receiver
            android:name=".AdbReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.mendypf.prompter.TOGGLE" />
                <action android:name="io.github.mendypf.prompter.SHOW" />
                <action android:name="io.github.mendypf.prompter.HEAR" />
                <action android:name="io.github.mendypf.prompter.SCRIPT" />
                <action android:name="io.github.mendypf.prompter.LOOK" />
                <action android:name="io.github.mendypf.prompter.PINCH" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
